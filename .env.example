# ============================================================
# EVREN MODEL API  (LLM + embedding — OpenAI uyumlu)
# ============================================================
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=sk-evren-teamNN-XXXXXXXX
EVREN_TIMEOUT=1800

LLM_MODEL=llm-fast
EMBEDDING_MODEL=bge-m3-embed
EMBEDDING_DIM=1024

# Sağlayıcı seçimi (ileride lokal modele geçiş için). Şu an yalnızca "evren".
LLM_BACKEND=evren
EMBEDDING_BACKEND=evren

# ============================================================
# EVREN QDRANT  (vektör veritabanı)
# ============================================================
QDRANT_URL=https://evren-vektor.ssyz.org.tr
QDRANT_PORT=443
EVREN_TEAM=teamNN
EVREN_QDRANT_KEY=qdr-teamNN-XXXXXXXX
QDRANT_COLLECTION=karonext_products
QDRANT_TIMEOUT=600
DEFAULT_TOP_K=5

# ============================================================
# API
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# DATA  (geriye dönük uyumluluk — kanonik kaynak: data/final/karonext.sqlite)
# ============================================================
INPUT_CSV=./data/input/kaynak_469.csv
PROCESSED_JSONL=./data/processed/extracted_records.jsonl
ERROR_JSONL=./data/processed/errors.jsonl
